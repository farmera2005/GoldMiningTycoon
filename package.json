{
  "name": "gold-mining-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Single-player browser business simulation of a small placer gold mining company.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run --project engine",
    "test:e2e": "playwright test",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "sim": "tsx sim/cli.ts",
    "sim:balance": "tsx sim/balance/cli.ts",
    "replay": "tsx sim/replay.ts",
    "goldens:update": "tsx tests/golden/update.ts",
    "calibrate:world": "tsx sim/calibration/world.ts",
    "calibrate:estimator": "tsx sim/calibration/estimator.ts"
  },
  "dependencies": {
    "@fontsource/besley": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
